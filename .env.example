# notey configuration — copy to .env and edit. All values are optional; defaults shown.

# Bind address. 0.0.0.0 exposes on all interfaces (needed for Docker / public IP).
NOTEY_HOST=0.0.0.0

# Port to listen on.
NOTEY_PORT=8080

# Where notes are stored. Defaults to ./note-store. In Docker this is set to /data
# (a mounted volume) so notes persist across restarts and redeploys.
# NOTEY_STORE=./note-store

# Static frontend directory. Defaults to ./frontend — rarely needs changing.
# NOTEY_FRONTEND=./frontend

# Only used by `docker compose --profile tunnel up` — a Cloudflare Tunnel token.
# Create one in the Cloudflare Zero Trust dashboard (Networks → Tunnels).
# CLOUDFLARE_TUNNEL_TOKEN=
